<Project Sdk="Microsoft.NET.Sdk">
  <!-- .NET Framework 4.8 ist auf Windows 10/11 vorinstalliert → kleine exe ohne Extra-Runtime -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Setwerk</AssemblyName>
    <RootNamespace>Setwerk</RootNamespace>
    <ApplicationIcon>setwerk.ico</ApplicationIcon>
    <Product>Setwerk</Product>
    <Company>Setwerk</Company>
    <Description>Setwerk – DJ-Set-Planer</Description>
    <Version>1.1.0</Version>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2210.55" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>
</Project>
