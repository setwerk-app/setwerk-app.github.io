<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
  <title>Setwerk</title>
  <welcome file="welcome.html" mime-type="text/html"/>
  <conclusion file="conclusion.html" mime-type="text/html"/>
  <background file="background.png" alignment="bottomleft" scaling="none"/>
  <background-darkAqua file="background.png" alignment="bottomleft" scaling="none"/>
  <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>
  <domains enable_localSystem="true" enable_currentUserHome="false" enable_anywhere="false"/>
  <volume-check>
    <allowed-os-versions><os-version min="13.0"/></allowed-os-versions>
  </volume-check>
  <choices-outline><line choice="default"><line choice="io.github.setwerk.app"/></line></choices-outline>
  <choice id="default"/>
  <choice id="io.github.setwerk.app" visible="false" title="Setwerk">
    <pkg-ref id="io.github.setwerk.app"/>
  </choice>
  <pkg-ref id="io.github.setwerk.app" version="__VERSION__" onConclusion="none">Setwerk-component.pkg</pkg-ref>
</installer-gui-script>
